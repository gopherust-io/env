# Intentional misconfigurations for Config Doctor demos.
# Run from repo root:
#   go run ./cmd/envgen doctor -dir ./examples/basic -type Config -env-file ./examples/basic/.env.doctor -mode prod -prefix DB_
#
# Typo: DB_HST → should be DB_HOST
DB_HST=db.internal
# Orphan under DB_ prefix
DB_POOL_SIZE=16
# Looks like a secret but field is not sensitive (BASE_URL is schema; use a fake token key via all-unknown isn't needed)
# Unmarked secret on a real field — set API-like value on LABELS? Use TIMEOUT unset for silent default instead.
# Required DB_HOST missing (only typo present).
DB_PASSWORD=super-secret
DB_PORT=5432
